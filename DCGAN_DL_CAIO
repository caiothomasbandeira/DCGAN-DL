    "os.makedirs('output_images', exist_ok=True)\n",
    "os.makedirs('pesos_salvos',  exist_ok=True)\n",
    "\n",
    "G_losses, D_losses = [], []\n",
    "Dx_values, DGz_values = [], []\n",
    "\n",
    "print(\"Iniciando Loop de Treinamento Expresso (Sem FID no meio)...\")\n",
    "\n",
    "# --- FUNÇÃO HELPER PARA ADICIONAR RUÍDO ---\n",
    "def add_noise(imgs, strength=0.05):\n",
    "    return imgs + strength * torch.randn_like(imgs)\n",
    "\n",
    "for epoch in range(epochs):\n",
    "    for i, data in enumerate(dataloader, 0):\n",
    "\n",
    "        ############################\n",
    "        # (1) Atualiza Discriminador\n",
    "        ###########################\n",
    "        netD.zero_grad()\n",
    "        real_cpu = data[0].to(device)\n",
    "        b_size   = real_cpu.size(0)\n",
    "        \n",
    "        # LABEL SMOOTHING (0.9 em vez de 1.0)\n",
    "        label    = torch.full((b_size, 1), 0.9, dtype=torch.float, device=device)\n",
    "\n",
    "        # INJEÇÃO DE RUÍDO (Imagens Reais)\n",
    "        real_cpu_noisy = add_noise(real_cpu)\n",
    "        output      = netD(real_cpu_noisy)\n",
    "        errD_real   = criterion(output, label)\n",
    "        errD_real.backward()\n",
    "        D_x         = output.mean().item()\n",
    "\n",
    "        noise       = torch.randn(b_size, latent_dim, device=device)\n",
    "        fake        = netG(noise)\n",
    "        label.fill_(0.0)\n",
    "        \n",
    "        # INJEÇÃO DE RUÍDO (Imagens Falsas para o D)\n",
    "        fake_noisy_for_D = add_noise(fake.detach())\n",
    "        output      = netD(fake_noisy_for_D)\n",
    "        errD_fake   = criterion(output, label)\n",
    "        errD_fake.backward()\n",
    "        D_G_z1      = output.mean().item()\n",
    "        errD        = errD_real + errD_fake\n",
    "        optimizerD.step()\n",
    "\n",
    "        ############################\n",
    "        # (2) Atualiza Gerador\n",
    "        ###########################\n",
    "        netG.zero_grad()\n",
    "        label.fill_(1.0) # Gerador sempre mira no 1.0\n",
    "        \n",
    "        # INJEÇÃO DE RUÍDO (Imagens Falsas para o G)\n",
    "        fake_noisy_for_G = add_noise(fake)\n",
    "        output  = netD(fake_noisy_for_G)\n",
    "        errG    = criterion(output, label)\n",
    "        errG.backward()\n",
    "        D_G_z2  = output.mean().item()\n",
    "        optimizerG.step()\n",
    "\n",
    "        if i % 50 == 0:\n",
    "            print(f'[{epoch}/{epochs}][{i}/{len(dataloader)}] Loss_D: {errD.item():.4f} Loss_G: {errG.item():.4f} D(x): {D_x:.4f} D(G(z)): {D_G_z1:.4f} / {D_G_z2:.4f}')\n",
    "\n",
    "        G_losses.append(errG.item())\n",
    "        D_losses.append(errD.item())\n",
    "        Dx_values.append(D_x)\n",
    "        DGz_values.append(D_G_z2)\n",
    "\n",
    "    # Imagem de progresso visual\n",
    "    with torch.no_grad():\n",
    "        fake_display = netG(fixed_noise).detach().cpu()\n",
    "    save_image(fake_display, f'output_images/epoch_{epoch:03d}.png', normalize=True)\n",
    "\n",
    "    # Apenas salva os pesos a cada FID_INTERVAL (Sem rodar avaliação pesada)\n",
    "    if (epoch + 1) % FID_INTERVAL == 0:\n",
    "        print(f\"\\n[Época {epoch + 1}] Salvando Pesos de Segurança...\")\n",
    "        model_G_sv = netG.module if hasattr(netG, 'module') else netG\n",
    "        torch.save(model_G_sv.state_dict(), f'pesos_salvos/netG_epoch_{epoch+1}.pth')\n",
    "        \n",
    "    gc.collect()\n",
    "\n",
    "print(\"Treinamento de 500 épocas Concluído com Sucesso!\")"

    "                              shuffle=False, num_workers=0)\n",
    "\n",
    "# 2. Função: extrai features de imagens reais\n",
    "def get_real_features(loader, model, num_samples):\n",
    "    features, count = [], 0\n",
    "    with torch.no_grad():\n",
    "        for images, _ in loader:\n",
    "            if count >= num_samples:\n",
    "                break\n",
    "            images = images.to(device)\n",
    "            pred   = model(images)\n",
    "            features.append(pred.cpu().numpy())\n",
    "            count  += images.size(0)\n",
    "    return np.concatenate(features, axis=0)[:num_samples]\n",
    "\n",
    "# 3. Função: extrai features de imagens GERADAS (diretamente do netG)\n",
    "def get_fake_features(generator, inception_model, num_samples, latent_size, batch_sz, dev):\n",
    "    features, count = [], 0\n",
    "    generator.eval()\n",
    "    with torch.no_grad():\n",
    "        while count < num_samples:\n",
    "            n   = min(batch_sz, num_samples - count)\n",
    "            z   = torch.randn(n, latent_size, device=dev)\n",
    "            img = generator(z)                                             \n",
    "            up  = nn.functional.interpolate(img, size=(299, 299), mode='bilinear', align_corners=False)  \n",
    "            pred = inception_model(up)\n",
    "            features.append(pred.cpu().numpy())\n",

    "# Diretório para salvar o progresso\n",
    "os.makedirs('output_images', exist_ok=True)\n",
    "\n",
    "G_losses = []\n",
    "D_losses = []\n",
    "\n",
    "Dx_values = []\n",
    "DGz_values = []\n",
    "\n",
    "print(\"Iniciando Loop de Treinamento...\")\n",
    "\n",
    "for epoch in range(epochs):\n",
    "    for i, data in enumerate(dataloader, 0):\n",
    "        \n",
    "        ############################\n",
    "        # (1) Atualiza a rede D: maximiza log(D(x)) + log(1 - D(G(z)))\n",
    "        ###########################\n",
    "        netD.zero_grad()\n",
    "        \n",
    "        # Batch Real\n",
    "        real_cpu = data[0].to(device)\n",
    "        b_size = real_cpu.size(0)\n",
    "        label = torch.full((b_size, 1), 1.0, dtype=torch.float, device=device)\n",
    "        \n",
    "        output = netD(real_cpu)\n",
    "        errD_real = criterion(output, label)\n",
    "        errD_real.backward()\n",
    "        D_x = output.mean().item()\n",
    "\n",
    "        # Batch Falso (Gerado)\n",
    "        noise = torch.randn(b_size, latent_dim, device=device)\n",
    "        fake = netG(noise)\n",
    "        label.fill_(0.0) # Troca o label alvo para 0 (falso)\n",
    "        \n",
    "        output = netD(fake.detach())\n",
    "        errD_fake = criterion(output, label)\n",
    "        errD_fake.backward()\n",
    "        D_G_z1 = output.mean().item()\n",
    "        \n",
    "        errD = errD_real + errD_fake\n",
    "        optimizerD.step()\n",
    "\n",
    "        ############################\n",
    "        # (2) Atualiza a rede G: maximiza log(D(G(z)))\n",
    "        ###########################\n",
    "        netG.zero_grad()\n",
    "        label.fill_(1.0) # Label alvo muda para 1.0 (o Gerador quer enganar o D)\n",
    "        \n",
    "        output = netD(fake)\n",
    "        errG = criterion(output, label)\n",
    "        errG.backward()\n",
    "        D_G_z2 = output.mean().item()\n",
    "        \n",
    "        optimizerG.step()\n",
    "        \n",
    "        # Estatísticas do Batch\n",
    "        if i % 50 == 0:\n",
    "            print(f'[{epoch}/{epochs}][{i}/{len(dataloader)}] '\n",
    "                  f'Loss_D: {errD.item():.4f} Loss_G: {errG.item():.4f} '\n",
    "                  f'D(x): {D_x:.4f} D(G(z)): {D_G_z1:.4f} / {D_G_z2:.4f}')\n",
    "        \n",
    "        G_losses.append(errG.item())\n",
    "        D_losses.append(errD.item())\n",
    "        Dx_values.append(D_x)\n",
    "        DGz_values.append(D_G_z2) # Usamos o z2 que é após a atualização do G\n",
    "\n",
    "    # Ao final de cada época, salva as imagens geradas usando o vetor fixo\n",
    "    with torch.no_grad():\n",
    "        fake_display = netG(fixed_noise).detach().cpu()\n",
    "    save_image(fake_display, f'output_images/epoch_{epoch:03d}.png', normalize=True)\n",
    "\n",
    "print(\"Treinamento Concluído!\")"
